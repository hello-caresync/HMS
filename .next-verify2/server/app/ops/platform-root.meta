{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/ops/layout,_N_T_/ops/platform-root/layout,_N_T_/ops/platform-root/page,_N_T_/ops/platform-root"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/ops/platform-root/__PAGE__",
    "/ops/platform-root",
    "/ops",
    "/_index",
    "/_head"
  ]
}