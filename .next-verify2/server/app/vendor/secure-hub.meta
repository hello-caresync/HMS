{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/vendor/layout,_N_T_/vendor/secure-hub/layout,_N_T_/vendor/secure-hub/page,_N_T_/vendor/secure-hub"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/vendor/secure-hub/__PAGE__",
    "/vendor/secure-hub",
    "/vendor",
    "/_index",
    "/_head"
  ]
}