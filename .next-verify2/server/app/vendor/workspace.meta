{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/vendor/layout,_N_T_/vendor/workspace/layout,_N_T_/vendor/workspace/page,_N_T_/vendor/workspace"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/vendor/workspace/__PAGE__",
    "/vendor/workspace",
    "/vendor",
    "/_index",
    "/_head"
  ]
}